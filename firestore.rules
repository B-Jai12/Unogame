rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users Collection ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Usernames Registry ───────────────────────────────────────────────────
    match /usernames/{username} {
      allow read:  if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ─── Rooms Collection ─────────────────────────────────────────────────────
    match /rooms/{roomId} {
      // Anyone authenticated can read room state
      allow read: if request.auth != null;

      // Create: authenticated user creating a room they host
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid;

      // Update: host, existing players, or new players joining
      allow update: if request.auth != null
        && (
          // Host can update anything
          request.auth.uid == resource.data.hostId ||
          // Existing players can update their own presence/actions
          request.auth.uid in resource.data.playerIds ||
          // New players can join if room is waiting and they only add themselves
          (resource.data.status == 'waiting' && 
           request.resource.data.playerIds.hasAll(resource.data.playerIds.concat([request.auth.uid])))
        );

      // Delete: only the host can delete the room
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.hostId;

      // ─── Action Requests Subcollection (Guest → Host) ─────────────────────
      match /actionRequests/{reqId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        // Host (only) may delete after processing
        allow delete: if request.auth != null;
        allow update: if false; // Immutable once written
      }

      // ─── Chat Messages Subcollection ──────────────────────────────────────
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false; // Immutable
      }
    }
  }
}
